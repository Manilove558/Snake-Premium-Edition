# --- Frontend (Next.js) ------------------------------------------------------
# URL of the Socket.io game server (server/index.ts). In production use wss/https.
NEXT_PUBLIC_SNAKE_SERVER_URL=http://localhost:4000

# --- Game server (server/index.ts) ---------------------------------------------
# PORT=4000
# Comma separated origins allowed to connect. Default already covers next dev + Capacitor WebViews.
# CORS_ORIGINS=https://your-site.com,http://localhost:3000,capacitor://localhost,http://localhost,https://localhost
# Firebase ID-token verification (recommended for ranked). Paste the service-account
# JSON on ONE line (Firebase Console -> Project settings -> Service accounts -> Generate new private key).
# Without it, socket connections are accepted but UNVERIFIED (no verified badge, ranked skipped).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# v23 — server-side ranked settling (Admin SDK writes ranked/{uid}); required for ranked rooms
# FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.firebaseio.com
