# --- Frontend (Next.js) ------------------------------------------------------
# URL of the Socket.io game server (server/index.ts). In production use wss/https.
NEXT_PUBLIC_SNAKE_SERVER_URL=http://localhost:4000

# --- Game server (server/index.ts) ---------------------------------------------
# PORT=4000
# Comma separated origins allowed to connect. Default already covers next dev + Capacitor WebViews.
# CORS_ORIGINS=https://your-site.com,http://localhost:3000,capacitor://localhost,http://localhost,https://localhost
