# --- Snake Game Server (.env.example) -------------------------------------------
# Is file ko copy karke `.env` banao:  cp .env.example .env
# Phir neeche wali values apni asli values se bharo.
# NOTE: yahan koi asli secret mat likho — yeh sirf example hai.

# Server kis port par chalega (game client isi port se connect hota hai)
PORT=4000

# Kaun-kaun se origins connect kar sakte hain (comma se alag karo).
# Apne game ki website / app ka URL yahan daalo. Default me localhost + Capacitor shamil hai.
# CORS_ORIGINS=https://tumhari-site.com,http://localhost:3000,capacitor://localhost,http://localhost,https://localhost

# --- Ranked matches ke liye (Firebase Admin SDK) --------------------------------
# Firebase Console -> Project settings -> Service accounts -> "Generate new private key"
# se jo JSON mile, use POORI EK LINE me yahan paste karo (line break mat todo).
# Iske bina server chalega par ranked rooms kaam nahi karenge (RANKED_UNAVAILABLE).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"tumhara-project", ... }

# Tumhare Realtime Database ka URL (Firebase Console -> Realtime Database me dikhta hai)
# FIREBASE_DATABASE_URL=https://tumhara-project-default-rtdb.asia-southeast1.firebasedatabase.app
